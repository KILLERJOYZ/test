# =============================================================================
# SENSITIVE FILES & CREDENTIALS (Bảo mật: Chứa API Key, Password, Token)
# =============================================================================
.env
.env.*
*.env
*.pem
*.key
*.crt
# Cho phép lưu trữ các file mẫu .env.example lên git
!.env.example
!*.env.example

# =============================================================================
# PYTHON & VIRTUAL ENVIRONMENTS (Rất nặng: Thư mục môi trường ảo và thư viện)
# =============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =============================================================================
# NODE.JS & CRAWLER (node_modules rất cồng kềnh)
# =============================================================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Puppeteer / Headless browser binary cache
.cache/
.puppeteer/
puppeteer_cache/

# =============================================================================
# DBT (DATA BUILD TOOL) ARTIFACTS (File build tự sinh và log)
# =============================================================================
target/
**/target/
dbt_packages/
**/dbt_packages/
dbt_modules/
**/dbt_modules/
logs/
**/logs/
*.log

# =============================================================================
# LOCAL DATABASES & VECTOR STORAGE (CSDL cục bộ và dữ liệu nhị phân)
# =============================================================================
data/images/
**/data/images/
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
qdrant_storage/
storage/
local_qdrant/
*.pgdump
*.sql.gz

# =============================================================================
# TESTING, COVERAGE & PROFILING
# =============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# =============================================================================
# IDE & CODE EDITORS (Cài đặt cá nhân)
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# =============================================================================
# OPERATING SYSTEM (Windows & macOS)
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
