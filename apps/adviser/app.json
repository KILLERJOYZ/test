{
  "expo": {
    "name": "Lựa · Device Advisor",
    "slug": "lua-adviser",
    "version": "0.3.0",
    "platforms": [
      "android"
    ],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "vn.lua.adviser",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "extra": {
      "dataset": "manufacturer-retailer-reference-v1",
      "aiMode": "optional-on-device"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.3.21"
          }
        }
      ],
      "./plugins/with-advisor-network.cjs",
      "./plugins/with-advisor-ksp.cjs"
    ]
  }
}
