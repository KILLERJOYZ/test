{
  "name": "lua-android-demo",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "build": "npm run tokens && tsc --noEmit && vite build && node scripts/standalone.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/domain.test.ts src/picker.test.ts src/ai.test.ts src/decision-state.test.ts src/catalog.test.ts src/adviser-store.test.ts src/adviser-client.test.ts src/local-ai.test.ts src/integration.test.ts src/reference.test.ts src/advisor-engine.test.ts src/device-profile.test.ts",
    "catalog:import": "node --experimental-strip-types scripts/import-catalog.mjs",
    "service:adviser": "node --env-file-if-exists=../../services/adviser/.env ../../services/adviser/server.mjs",
    "test:adviser-service": "node --experimental-strip-types --test ../../services/adviser/server.test.mjs",
    "start": "expo start --tunnel",
    "android": "expo start --go --android",
    "ai": "node --env-file-if-exists=../../services/demo-ai/.env ../../services/demo-ai/server.mjs",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:debug": "expo run:android",
    "android:native": "expo run:android",
    "android:release": "expo run:android --variant release",
    "export:android": "expo export --platform android",
    "test:service": "node --experimental-strip-types --test ../../services/demo-ai/server.test.mjs",
    "tokens": "node --experimental-strip-types scripts/tokens.mjs",
    "test:demo2": "node scripts/test-demo2-flow.mjs",
    "ios": "expo run:ios",
    "reference:database": "python ../../tools/catalog/normalize_reference.py && python ../../tools/catalog/build_reference.py",
    "test:device-system": "node scripts/test-device-system.mjs",
    "catalog:prepare": "node scripts/catalog-server.mjs --prepare",
    "catalog:serve": "node scripts/catalog-server.mjs",
    "catalog:test": "node scripts/catalog-server.mjs --test",
    "test:catalog-system": "node scripts/test-catalog-system.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-system-ui": "~58.0.7",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/react-native-web": "^0.19.0",
    "babel-preset-expo": "~58.0.25",
    "esbuild": "^0.25.12",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2",
    "vite": "^6.1.0"
  },
  "type": "module",
  "main": "index.js"
}
