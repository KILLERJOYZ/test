{
  "name": "lua-android-demo",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "npm run tokens && tsc --noEmit && vite build && node scripts/standalone.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/domain.test.ts src/picker.test.ts src/ai.test.ts src/integration.test.ts src/reference.test.ts src/advisor-engine.test.ts src/device-profile.test.ts",
    "start": "expo start",
    "android": "expo start --go --android",
    "ai": "node --env-file-if-exists=../../services/demo-ai/.env ../../services/demo-ai/server.mjs",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:native": "expo run:android",
    "android:release": "expo run:android --variant release",
    "export:android": "expo export --platform android",
    "test:service": "node --experimental-strip-types --test ../../services/demo-ai/server.test.mjs",
    "tokens": "node --experimental-strip-types scripts/tokens.mjs",
    "test:demo2": "node scripts/test-demo2-flow.mjs",
    "ios": "expo run:ios",
    "reference:database": "python ../../tools/catalog/normalize_reference.py && python ../../tools/catalog/build_reference.py",
    "test:device-system": "node scripts/test-device-system.mjs",
    "catalog:prepare": "node scripts/catalog-server.mjs --prepare",
    "catalog:serve": "node scripts/catalog-server.mjs",
    "catalog:test": "node scripts/catalog-server.mjs --test",
    "test:catalog-system": "node scripts/test-catalog-system.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-sqlite": "~16.0.10",
    "expo-system-ui": "~6.0.9",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@types/react-native-web": "^0.19.0",
    "babel-preset-expo": "~54.0.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.5.3",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2",
    "vite": "^6.1.0"
  },
  "type": "module",
  "main": "index.js"
}
