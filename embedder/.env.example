# Qdrant Database Configuration
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=laptops
QDRANT_API_KEY=

# Data folder (defaults to ../data)
# DATA_DIR=../data

# Embedding Provider: 'local', 'gemini', 'openai', or 'ollama'
# Default is 'local' (offline fast feature hashing, zero API keys needed)
EMBEDDING_PROVIDER=local

# Google Gemini Embedding (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI Embedding (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama Embedding (Optional)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=nomic-embed-text
